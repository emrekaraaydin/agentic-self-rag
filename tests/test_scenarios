import asyncio
import logging
from typing import Any, Dict, List
from src.graph import app

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s [%(levelname)s] %(name)s: %(message)s",
)
logger = logging.getLogger(__name__)


async def execute_test_case(scenario_name: str, question: str) -> Dict[str, Any]:
    print(f"\n{'='*20} {scenario_name.upper()} {'='*20}")
    print(f"Input Query: {question}\n")

    initial_state = {
        "question": question,
        "generation": "",
        "documents": [],
        "retry_count": 0,
    }

    traversed_nodes: List[str] = []

    try:
        # Asenkron stream ile düğüm adımlarını takip etme
        async for step_output in app.astream(initial_state):
            for node_name in step_output.keys():
                traversed_nodes.append(node_name)
                print(f"Node Executed: [{node_name}]")

        final_state = await app.ainvoke(initial_state)

        print(f"\nExecution Path: {' -> '.join(traversed_nodes)}")
        print(f"Final Answer Preview: {final_state.get('generation', '')[:120]}...\n")

        return {
            "scenario": scenario_name,
            "path": traversed_nodes,
            "final_state": final_state,
        }
    except Exception as exc:
        logger.error(f"Test scenario execution failed: {exc}", exc_info=True)
        return {"scenario": scenario_name, "path": traversed_nodes, "error": str(exc)}


async def run_all_scenarios() -> None:
    test_cases = [
        {
            "name": "Scenario 1: Direct Knowledge Base Hit",
            "query": "What is the core purpose of LangGraph in our internal architecture?",
        },
        {
            "name": "Scenario 2: Out of Domain / Missing Knowledge (Retry & Fail-Safe)",
            "query": "What is the secret deployment key for the legacy production server?",
        },
    ]

    results = []
    for test_case in test_cases:
        result = await execute_test_case(test_case["name"], test_case["query"])
        results.append(result)

    print("\n" + "=" * 50)
    print("TEST SUITE SUMMARY")
    print("=" * 50)
    for res in results:
        path_str = " -> ".join(res.get("path", []))
        print(f"[{res['scenario']}]: {path_str}")


if __name__ == "__main__":
    asyncio.run(run_all_scenarios())